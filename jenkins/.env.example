# Plantilla de configuración: crear jenkins/.env a partir de este archivo y completar los valores.
# .env solo lleva configuración NO sensible. Las contraseñas de Jenkins y el token de Docker Hub se guardan
# cifrados en el Administrador de credenciales de Windows con secretos\guardar-secretos.ps1.
#
# Registro de destino: docker.io (Docker Hub, requiere usuario y token) o localhost:5000
# (registro local definido en docker-compose, sin credenciales).
REGISTRY_HOST=localhost:5000
DOCKERHUB_USER=tu-usuario
GIT_REPO_URL=https://github.com/tu-usuario/lab-cicd.git
DOCKER_GID=0
# Puerto de Jenkins en el equipo anfitrión; modificarlo si el 8080 está en uso (por ejemplo, 8090).
JENKINS_PORT=8080
