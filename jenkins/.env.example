# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a Git.
JENKINS_ADMIN_PASSWORD=cambia-esta-clave
# Dónde publicar la imagen: docker.io (Docker Hub, necesita usuario y token) o localhost:5000
# (registro local de docker-compose, sin cuenta; en ese caso el token puede quedar como está).
REGISTRY_HOST=docker.io
DOCKERHUB_USER=tu-usuario-de-dockerhub
# Token de acceso de Docker Hub (Account settings > Personal access tokens), no tu contraseña.
DOCKERHUB_TOKEN=pega-aqui-el-token
GIT_REPO_URL=https://github.com/tu-usuario/catalogo-cursos.git
DOCKER_GID=0
# Cambia el puerto si el 8080 ya está ocupado (por ejemplo, 8090).
JENKINS_PORT=8080
