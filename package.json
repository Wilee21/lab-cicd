{
  "name": "catalogo-cursos",
  "version": "1.0.0",
  "description": "Aplicación web de referencia para la implementación de pipelines de CI/CD (Fundamentos DevOps)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:reporte": "eslint . --format json --output-file reportes/eslint.json",
    "test": "node --test \"test/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reportes/junit.xml --test-reporter=lcov --test-reporter-destination=reportes/lcov.info \"test/*.test.js\"",
    "test:en-vivo": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reportes/junit-en-vivo.xml \"test/en-vivo/*.test.js\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
